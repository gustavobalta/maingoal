rules_version = '2';

// A app não usa Firebase Auth — o acesso é protegido apenas pelo PIN no
// frontend, pelo que estas regras replicam o comportamento anterior:
// leitura e escrita abertas a quem conhecer o URL do projeto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
